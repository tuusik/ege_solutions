'''def f(n):
    d = []
    while n > 0:
        d.append(n % 7)
        n //= 7
    return d
count = 0
for i in range(7**4, 7**5):
    d = f(i)
    count_0 = d.count(0)
    count_1 = d.count(1)

    if count_0 == 1 and count_1 <= 2:
        count += 1
print(count)'''

