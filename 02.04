'''
print(5+3+1+3+5+4+5)'''

from turtle import*
k = 20
speed(0)
tracer(0)
for i in range(2):
    forward(1*k)
    left(270)
    forward(16*k)
    right(90)
up()
back(4*k)
right(90)
forward(10*k)
left(90)
down()
for i in range(2):
    forward(17*k)
    right(90)
    forward(7*k)
    right(90)
up()
for x in range(10):
    for y in range(-10,30):
        goto (x*k, y*k - 180)
        dot(5, 'red')
